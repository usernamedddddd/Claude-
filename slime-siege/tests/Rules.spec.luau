--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Targeting = require(ReplicatedStorage.Shared.Sim.Targeting)
local Placement = require(ReplicatedStorage.Shared.Sim.Placement)
local Path = require(ReplicatedStorage.Shared.Sim.Path)
local Votes = require(ReplicatedStorage.Shared.Sim.Votes)
local MapData = require(ReplicatedStorage.Shared.Data.MapData)

return function()
	describe("targeting modes", function()
		local a = { distance = 50, layers = 1, x = 0, z = 10 }
		local b = { distance = 20, layers = 6, x = 0, z = 2 }
		local c = { distance = 35, layers = 6, x = 0, z = 30 }
		local list = { a, b, c }

		it("First picks the furthest along the path", function()
			expect(Targeting.pick(list, "First", 1, 0, 0)[1]).to.equal(a)
		end)
		it("Last picks the least progressed", function()
			expect(Targeting.pick(list, "Last", 1, 0, 0)[1]).to.equal(b)
		end)
		it("Strong picks most layers, breaking ties by progress", function()
			expect(Targeting.pick(list, "Strong", 1, 0, 0)[1]).to.equal(c)
		end)
		it("Close picks the nearest to the tower", function()
			expect(Targeting.pick(list, "Close", 1, 0, 0)[1]).to.equal(b)
		end)
		it("picks distinct targets in priority order", function()
			local picked = Targeting.pick(list, "First", 5, 0, 0)
			expect(#picked).to.equal(3)
			expect(picked[1]).to.equal(a)
			expect(picked[2]).to.equal(c)
			expect(picked[3]).to.equal(b)
		end)
		it("validates mode strings", function()
			expect(Targeting.isMode("Strong")).to.equal(true)
			expect(Targeting.isMode("strong")).to.equal(false)
			expect(Targeting.isMode(5)).to.equal(false)
		end)
	end)

	describe("placement", function()
		local path = Path.build(MapData.waypoints)
		it("rejects the path, decorations, other towers, out of bounds and NaN", function()
			expect((Placement.check(MapData, path, {}, 1.5, -40, 0))).to.equal(false)
			expect((Placement.check(MapData, path, {}, 1.5, 5, 0))).to.equal(false)
			expect((Placement.check(MapData, path, { { x = -34, z = 19, footprint = 1.5 } }, 1.5, -33, 19))).to.equal(
				false
			)
			expect((Placement.check(MapData, path, {}, 1.5, 500, 0))).to.equal(false)
			expect((Placement.check(MapData, path, {}, 1.5, 0 / 0, 0))).to.equal(false)
		end)
		it("accepts open ground", function()
			expect((Placement.check(MapData, path, {}, 1.5, -34, 19))).to.equal(true)
		end)
	end)

	describe("path", function()
		it("maps distance to position along the waypoints", function()
			local path = Path.build(MapData.waypoints)
			local x, z = Path.positionAt(path, 0)
			expect(x).to.equal(MapData.waypoints[1].x)
			expect(z).to.equal(MapData.waypoints[1].z)
			x, z = Path.positionAt(path, 36 + 10)
			expect(x).to.be.near(-40)
			expect(z).to.be.near(-20)
			x, z = Path.positionAt(path, path.totalLength + 100)
			expect(x).to.be.near(MapData.waypoints[#MapData.waypoints].x)
		end)
	end)

	describe("votes", function()
		it("needs a strict majority", function()
			expect(Votes.hasMajority(1, 1)).to.equal(true)
			expect(Votes.hasMajority(1, 2)).to.equal(false)
			expect(Votes.hasMajority(2, 2)).to.equal(true)
			expect(Votes.hasMajority(2, 4)).to.equal(false)
			expect(Votes.hasMajority(3, 4)).to.equal(true)
			expect(Votes.hasMajority(0, 0)).to.equal(false)
		end)
		it("ignores votes from players who left", function()
			expect(Votes.count({ [1] = true, [2] = true, [3] = false }, { [1] = true })).to.equal(1)
		end)
	end)
end
